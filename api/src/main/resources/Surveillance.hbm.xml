<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.sihsalusepidemiologicalsurveillance.model" auto-import="true">
  <class name="NotifiableEvent" table="surveillance_notifiable_event">
    <id name="id" column="event_id" type="int"><generator class="native"/></id>
    <property name="retired" column="retired" type="boolean" not-null="true"/>
    <property name="uuid" column="uuid" type="string" not-null="true" unique="true" length="38"/>
    <many-to-one name="concept" column="concept_id" class="org.openmrs.Concept" not-null="true"/>
    <property name="name" column="name" type="string" not-null="true"/>
    <property name="periodicity" column="periodicity" type="string" not-null="true"/>
    <property name="deadlineDays" column="deadline_days" type="integer" not-null="true"/>
  </class>
  <class name="OutbreakAlertRule" table="surveillance_outbreak_alert_rule">
    <id name="id" column="rule_id" type="int"><generator class="native"/></id>
    <property name="uuid" column="uuid" type="string" not-null="true" unique="true" length="38"/>
    <many-to-one name="event" column="event_id" class="org.openmrs.module.sihsalusepidemiologicalsurveillance.model.NotifiableEvent" not-null="true"/>
    <property name="conditionType" column="condition_type" type="string" not-null="true"/>
    <property name="windowWeeks" column="window_weeks" type="integer" not-null="false"/>
    <property name="threshold" column="threshold" type="double" not-null="false"/>
    <property name="active" column="active" type="boolean" not-null="true"/>
  </class>
  <class name="PeriodCaseCount" table="surveillance_period_case_count">
    <id name="id" column="count_id" type="int"><generator class="native"/></id>
    <property name="uuid" column="uuid" type="string" not-null="true" unique="true" length="38"/>
    <many-to-one name="event" column="event_id" class="org.openmrs.module.sihsalusepidemiologicalsurveillance.model.NotifiableEvent" not-null="true"/>
    <property name="periodType" column="period_type" type="string" not-null="true"/>
    <property name="year" column="calendar_year" type="integer" not-null="true"/>
    <property name="periodNumber" column="period_number" type="integer" not-null="true"/>
    <property name="date" column="period_date" type="timestamp" not-null="false"/>
    <property name="caseCount" column="case_count" type="integer" not-null="true"/>
  </class>
  <class name="EpidemiologicalFocus" table="surveillance_epidemiological_focus">
    <id name="id" column="focus_id" type="int"><generator class="native"/></id>
    <property name="uuid" column="uuid" type="string" not-null="true" unique="true" length="38"/>
    <many-to-one name="event" column="event_id" class="org.openmrs.module.sihsalusepidemiologicalsurveillance.model.NotifiableEvent" not-null="true"/>
    <many-to-one name="location" column="location_id" class="org.openmrs.Location" not-null="true"/>
    <property name="classification" column="classification" type="string" not-null="true"/>
    <property name="receptive" column="receptive" type="boolean" not-null="true"/>
    <property name="lastCaseDate" column="last_case_date" type="timestamp" not-null="false"/>
  </class>
  <class name="SurveillanceAudit" table="surveillance_audit">
    <id name="id" column="audit_id" type="int"><generator class="native"/></id>
    <property name="uuid" column="uuid" type="string" not-null="true" unique="true" length="38"/>
    <many-to-one name="user" column="user_id" class="org.openmrs.User" not-null="true"/>
    <property name="timestamp" column="occurred_at" type="timestamp" not-null="true"/>
    <property name="actionType" column="action_type" type="string" not-null="true"/>
    <property name="affectedEntity" column="affected_entity" type="string" not-null="true"/>
    <property name="affectedRecordId" column="affected_record_id" type="integer" not-null="false"/>
    <property name="changedField" column="changed_field" type="string" not-null="false"/>
    <property name="previousValue" column="previous_value" type="text" not-null="false"/>
    <property name="newValue" column="new_value" type="text" not-null="false"/>
    <property name="result" column="result" type="string" not-null="true"/>
  </class>
  <class name="NotiNotification" table="surveillance_noti_notification">
    <id name="id" column="notification_id" type="int"><generator class="native"/></id>
    <property name="uuid" column="uuid" type="string" not-null="true" unique="true" length="38"/>
    <many-to-one name="encounter" column="encounter_id" class="org.openmrs.Encounter" not-null="true"/>
    <many-to-one name="event" column="event_id" class="org.openmrs.module.sihsalusepidemiologicalsurveillance.model.NotifiableEvent" not-null="true"/>
    <property name="formatVersion" column="format_version" type="string" not-null="true"/>
    <property name="exportContent" column="export_content" type="text" not-null="true"/>
    <property name="sendStatus" column="send_status" type="string" not-null="true"/>
    <property name="generatedAt" column="generated_at" type="timestamp" not-null="true"/>
  </class>
</hibernate-mapping>

