<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.9"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.9 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.9.xsd">
    <changeSet id="surveillance-case-patient-snapshot-20261009" author="sihsalus">
        <comment>Capture demographics only for new cases; historical values cannot be reconstructed.</comment>
        <addColumn tableName="surveillance_case">
            <column name="pregnant" type="boolean"/>
            <column name="patient_given_names" type="text"/>
            <column name="patient_paternal_surname" type="text"/>
            <column name="patient_maternal_surname" type="text"/>
            <column name="patient_sex" type="varchar(50)"/>
            <column name="patient_age" type="int"/>
            <column name="patient_residence" type="text"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
